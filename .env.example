# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` — it is already listed in .gitignore.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (Database: US_VISA, Collection: visa_data)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/?retryWrites=true&w=majority

# AWS credentials used by the model evaluation / pusher / prediction pipeline
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# S3 bucket that acts as the model registry (create it in us-east-1)
MODEL_BUCKET_NAME=rohit-usvisa-model-registry
